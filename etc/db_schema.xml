<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="mago_mcp_token" resource="default" engine="innodb" comment="Per-admin-user MCP Bearer Tokens">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="admin_user_id" unsigned="true" nullable="false" comment="Admin User ID"/>
        <column xsi:type="varchar" name="token_hash" nullable="false" length="64" comment="SHA-256 hash of the token (the plaintext is shown once at generation and never stored)"/>
        <column xsi:type="varchar" name="label" nullable="true" length="100" comment="Optional label, e.g. which MCP client this token is for"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="last_used_at" nullable="true" comment="Last Used At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAGO_MCP_TOKEN_HASH">
            <column name="token_hash"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGO_MCP_TOKEN_ADMIN_USER_ID" table="mago_mcp_token" column="admin_user_id" referenceTable="admin_user" referenceColumn="user_id" onDelete="CASCADE"/>
        <index referenceId="MAGO_MCP_TOKEN_ADMIN_USER_ID" indexType="btree">
            <column name="admin_user_id"/>
        </index>
    </table>
</schema>
