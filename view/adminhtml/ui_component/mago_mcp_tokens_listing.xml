<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mago_mcp_tokens_listing.mago_mcp_tokens_listing_data_source</item>
        </item>
    </argument>

    <settings>
        <spinner>mago_mcp_tokens_columns</spinner>
        <deps>
            <dep>mago_mcp_tokens_listing.mago_mcp_tokens_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="mago_mcp_tokens_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <dataProvider class="Mbm\MagoMcp\Ui\DataProvider\TokensDataProvider"
                      name="mago_mcp_tokens_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="mago_mcp_tokens_columns">
        <column name="entity_id" sortOrder="10">
            <settings>
                <label translate="true">ID</label>
                <filter>textRange</filter>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="admin_username" sortOrder="20">
            <settings>
                <label translate="true">Admin User</label>
                <filter>text</filter>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="label" sortOrder="30">
            <settings>
                <label translate="true">Label</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Active</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="50">
            <settings>
                <label translate="true">Created At</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
            </settings>
        </column>
        <column name="last_used_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="60">
            <settings>
                <label translate="true">Last Used At</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
            </settings>
        </column>
        <actionsColumn name="actions" class="Mbm\MagoMcp\Ui\Component\Listing\Column\TokenActions" sortOrder="70">
            <settings>
                <label translate="true">Actions</label>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
